# Obrigatorias
DATABASE_URL=postgresql://sales_order:sales_order@localhost:5433/sales_order?schema=public
KAFKA_BROKER=localhost:9092

# Opcionais (valores padrao)
NODE_ENV=development
PORT=3004
LOG_LEVEL=info
KAFKA_CLIENT_ID=ms-sales-order
KAFKA_SEND_TIMEOUT_MS=5000
# Groups das replicas (replay: group temporario fixo, ex. ms-sales-order.catalog-item-sync.replay-20261001)
CATALOG_ITEM_SYNC_GROUP_ID=ms-sales-order.catalog-item-sync
CUSTOMER_SYNC_GROUP_ID=ms-sales-order.customer-sync
TRANSPORT_TYPE_SYNC_GROUP_ID=ms-sales-order.transport-type-sync
CONSUMER_RETRY_RETRIES=5
CONSUMER_RETRY_INITIAL_MS=300
CONSUMER_RETRY_MAX_MS=30000
CONSUMER_PAUSE_MS=30000
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LOCK_TIMEOUT_MS=30000
IDEMPOTENCY_CLEANUP_INTERVAL_MS=3600000
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=100
HEALTH_CHECK_TIMEOUT_MS=1500
SHUTDOWN_TIMEOUT_MS=10000

# So para autoria de migration (prisma migrate dev --create-only)
# SHADOW_DATABASE_URL=postgresql://sales_order:sales_order@localhost:5433/sales_order_shadow?schema=public
