// Transactional Outbox: eventos gravados na mesma transacao do pedido e
// publicados pelo OutboxPublisherService. id = eventId do envelope.
// sequence: ordem total de gravacao. createdAt nao serve, pois eventos da
// mesma transacao compartilham o mesmo now().
model OutboxEvent {
  id            String    @id @default(uuid())
  sequence      BigInt    @unique @default(autoincrement())
  aggregateId   String
  eventType     String
  schemaVersion Int
  correlationId String
  payload       Json
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?

  @@index([publishedAt, sequence])
  @@map("outbox_events")
}
